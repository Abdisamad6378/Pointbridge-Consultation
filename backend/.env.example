# Backend Environment Variables

# Server
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=pointbridge

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=604800

# Security
# Comma-separated exact origins of the React app (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy so rate limits see real client IPs
TRUST_PROXY=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
